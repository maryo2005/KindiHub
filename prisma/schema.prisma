// ============================================
// DIGITAL HUB - Modelo de datos
// Base de datos SQLite con Prisma ORM
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- USUARIO / DOCENTE ----
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("docente") // docente, coordinador, director, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classrooms Classroom[]
}

// ---- AULA ----
model Classroom {
  id        String   @id @default(cuid())
  name      String   // Ej: "Aula Celeste"
  section   String   // Ej: "A", "B"
  age       String   // Ej: "3 años", "4 años", "5 años"
  year      Int      // Año escolar
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  students  Student[]
  notebooks FieldNotebook[]
}

// ---- ESTUDIANTE ----
model Student {
  id          String   @id @default(cuid())
  fullName    String
  dni         String?
  classroomId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom  Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  evidences  Evidence[]
}

// ---- CUADERNO DE CAMPO ----
model FieldNotebook {
  id           String   @id @default(cuid())
  title        String   // Nombre del cuaderno
  classroomId  String
  originalFile String?  // Ruta al archivo Word original subido
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  sessions  Session[]
}

// ---- SESIÓN DE APRENDIZAJE ----
model Session {
  id            String   @id @default(cuid())
  activityTitle String   // Título de la actividad
  sessionDate   DateTime // Fecha de la sesión
  area          String   // Área curricular
  competency    String   // Competencia
  standard      String?  // Estándar de aprendizaje
  capacities    String?  // Capacidades (separadas por |)
  notebookId    String
  status        String   @default("preparada") // preparada, activa, cerrada
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  notebook  FieldNotebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  criteria  SessionCriteria[]
  evidences Evidence[]
}

// ---- CRITERIOS DE EVALUACIÓN ----
model SessionCriteria {
  id          String @id @default(cuid())
  description String // Descripción del criterio
  sessionId   String

  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidences Evidence[]
}

// ---- EVIDENCIA ----
model Evidence {
  id                   String   @id @default(cuid())
  studentId            String
  sessionId            String
  criteriaId           String?
  type                 String   // texto, audio, foto, video, marcacion
  level                String?  // inicio, proceso, logrado, requiere_apoyo
  observation          String?  // Observación original de la docente
  transcription        String?  // Transcripción del audio (Whisper)
  aiDescription        String?  // Descripción generada por IA
  aiFeedback           String?  // Retroalimentación sugerida por IA
  confirmedDescription String?  // Descripción confirmada por docente
  confirmedFeedback    String?  // Retroalimentación confirmada por docente
  status               String   @default("pendiente") // pendiente, revisada, confirmada, corregida
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  confirmedAt          DateTime?
  createdBy            String?  // Trazabilidad: quién creó

  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session  Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  criteria SessionCriteria? @relation(fields: [criteriaId], references: [id])
  files    EvidenceFile[]
}

// ---- ARCHIVOS DE EVIDENCIA ----
model EvidenceFile {
  id         String   @id @default(cuid())
  evidenceId String
  filePath   String   // Ruta al archivo
  fileType   String   // audio/webm, image/jpeg, video/mp4, etc.
  fileSize   Int      @default(0) // Tamaño en bytes
  createdAt  DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
}
